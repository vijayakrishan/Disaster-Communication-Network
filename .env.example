# ==============================================================================
# ResQMesh Environment Configuration Template
# DO NOT commit real passwords or API keys to version control.
# Copy this file to .env and configure values appropriate for your environment.
# ==============================================================================

# Database Connection Details (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_database_password_here

# Security & Authentication
JWT_SECRET=your_jwt_secret_token_here_minimum_256_bits
API_KEY=your_generic_api_key_here

# Third-Party Notifications & Email OTP (Resend API)
RESEND_API_KEY=your_resend_api_key_here
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_app_specific_email_password

# Microservice Service Discovery / Inter-Service URLs
AUTH_SERVICE_URL=http://localhost:8081
DEVICE_SERVICE_URL=http://localhost:8082
USER_SERVICE_URL=http://localhost:8083
STATION_SERVICE_URL=http://localhost:8084
SOS_SERVICE_URL=http://localhost:8085
RESCUE_SERVICE_URL=http://localhost:8086

# Frontend API Base URLs (Vite)
VITE_AUTH_API=http://localhost:8081
VITE_DEVICE_API=http://localhost:8082
VITE_USER_API=http://localhost:8083
VITE_STATION_API=http://localhost:8084
VITE_SOS_API=http://localhost:8085
VITE_RESCUE_API=http://localhost:8086
