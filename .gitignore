*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Environment Variables & Credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# IDE & Editor Specific Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath
bin/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs & Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Coverage
coverage/
.nyc_output/
*.lcov

# Flutter / Mobile Artifacts
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies

